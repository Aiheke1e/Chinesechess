# CCPD is downloaded and indexed locally.  Keep the repository and generated
# multi-megabyte book out of Git; the importer and manifest are versioned.
data/ccpd_source/
data/ccpd*.zip
data/ccpd*.partial
data/opening_book*.json
data/opening_book*.json.gz

# Runtime screenshots are ignored, but recognition/test assets are required.
!templates/*.png
!fixture/*.png

# Pikafish runtime files are downloaded separately; keep only its licenses/docs.
engine_bin/*.7z
engine_bin/*.zip
engine_bin/*.exe
engine_bin/*.nnue
engine_bin/Pikafish-Android-*
engine_bin/Pikafish-Linux-*
engine_bin/Pikafish-MacOS-*

